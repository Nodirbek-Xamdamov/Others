# ---- Telegram ----
# BotFather bergan token
TELEGRAM_BOT_TOKEN=

# ---- LLM (OpenAI-mos API) ----
# OpenRouter + Claude. Key: https://openrouter.ai/keys (sk-or-v1-... bilan boshlanadi)
# Boshqa variant — Groq: LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Aqlli/qimmat model: oddiy savollar arzon modelda tugamasa yoki xato chiqsa, shunga avtomatik o'tiladi
LLM_MODEL=anthropic/claude-sonnet-5
# Arzon model: har savol shundan boshlanadi (2x arzon). Bo'sh qoldirilsa hamma narsa to'g'ridan-to'g'ri LLM_MODEL'da ishlaydi
LLM_SIMPLE_MODEL=anthropic/claude-haiku-4.5
# 429 (limit) bo'lsa kutmasdan shu modellarga o'tiladi (vergul bilan)
LLM_FALLBACK_MODEL=

# ---- Ma'lumot manbai ----
# fleetio = savollarga Fleetio saytidan javob (API, faqat o'qish); sheet = xlsx jadvaldan (eski rejim)
DATA_SOURCE=fleetio

# ---- Fleetio (Secure Fleet) API — savol-javob faqat o'qiydi; yozish faqat work order oqimida ----
# API key va Account-Token: https://secure.fleetio.com/api_keys . Key qo'shilgach botni qayta ishga tushirish shart emas.
SECUREFLEET_KEY=
SECUREFLEET_ACCOUNT_TOKEN=
SECUREFLEET_BASE_URL=https://secure.fleetio.com/api

# ---- Ma'lumot (jadval rejimi) ----
COMPANY_NAME=Logistika
SPREADSHEET_PATH=data/Fleet_Truck_Info_Board.xlsx
# Google Sheets jonli havola (ixtiyoriy). "Anyone with the link can view" bo'lishi kerak.
SHEET_URL=
# SHEET_URL bo'lsa shuncha daqiqada yangilanadi; bo'lmasa lokal fayl o'zgarganda avtomatik qayta o'qiladi
REFRESH_MINUTES=10

# ---- Vaqtinchalik login (/start dan keyin so'raladi). Ikkalasi bo'sh = login o'chiq. O'zgartirilsa hamma qayta kiradi ----
# '#' kabi belgilar bo'lsa qiymatni bitta qo'shtirnoqqa oling: BOT_PASSWORD='ab#12'
BOT_LOGIN=
BOT_PASSWORD=

# ---- Ruxsatlar (bo'sh = hamma foydalana oladi) ----
# Telegram ID'lar, vergul bilan: 123456789,987654321
ALLOWED_USER_IDS=
ADMIN_USER_IDS=

# ---- Work orders (guruhdagi invoys xabari + fayl -> Fleetio work order) ----
# Qaysi chatlardan work order yaratish mumkin: guruh ID (-100...) yoki shaxsiy chat uchun Telegram user ID, vergul bilan.
# Bo'sh = hech kim. Ruxsat yo'q chatda bot chat ID'ni o'zi ko'rsatadi. O'zgartirilsa restart shart emas.
WO_CHAT_IDS=
# 1 = sinov rejimi: Fleetio'ga hech narsa yozilmaydi, nima yaratilishi ko'rsatiladi
WO_DRY_RUN=
# Sanalar uchun vaqt zonasi (bo'sh = Fleetio foydalanuvchisiniki)
FLEETIO_TZ=
